# Copia in .env e compila. .env NON va mai committato.
IG_ACCESS_TOKEN=
IG_USER_ID=
# Host API: vuoto = automatico dal token (EAA... -> graph.facebook.com, IG... -> graph.instagram.com)
IG_API_HOST=
# Versione Graph API
IG_API_VERSION=v23.0
# URL pubblico da cui Meta scarica i media, es. raw GitHub del repo pubblico:
MEDIA_BASE_URL=https://raw.githubusercontent.com/CharosSrl/auto_ig/main/media/
PIXABAY_API_KEY=

# Solo per token Facebook (EAA...): servono a renderlo permanente con auto_ig.token_tool
APP_ID=
APP_SECRET=
